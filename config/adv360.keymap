#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>

#define KEYS_L   0  1  2  3  4  5  6 \
                14 15 16 17 18 19 20 \
                28 29 30 31 32 33 34 \
                46 47 48 49 50 51    \
                60 61 62 63 64

#define THUMBS_L     35 36 \
                           52 \
                     65 66 67 \

#define KEYS_R   7  8  9 10 11 12 13 \
                21 22 23 24 25 26 27 \
                39 40 41 42 43 44 45 \
                   54 55 56 57 58 59 \
                      71 72 73 74 75

#define THUMBS_R 37 38    \
                     53       \
                     68 69 70 \

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;  // orignally set to 300 from zmk docs
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS_L THUMBS_R>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;  // orignally set to 300 from zmk docs
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS_L THUMBS_R>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      bspc_del: backspace_delete {
          compatible = "zmk,behavior-mod-morph";
          label = "BACKSPACE_DELETE";
          #binding-cells = <0>;
          bindings = <&kp BACKSPACE>, <&kp DELETE>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      /* How to stack mod-morph and layer-tap: https://www.reddit.com/r/zmk/comments/12ujlmb/combing_modmorph_and_layer_tap/ */
      /* not using at the moment since shift backspace was annoying me */
      lt_bspc: layer_tap_bspc_del {
          compatible = "zmk,behavior-hold-tap";
          label = "LAYER_TAP_BACKSPACE_DELETE";
          #binding-cells = <2>;
          bindings = <&mo>, <&bspc_del>;
          tapping-term-ms = <200>;
      };

      qt_lt: quick_tap_layer_tap {
          compatible = "zmk,behavior-hold-tap";
          #binding-cells = <2>;
          flavor = "balanced";
          tapping-term-ms = <200>;
          quick-tap-ms = <300>;
          bindings = <&mo>, <&kp>;
          display-name = "Quick-Tap-Layer-Tap";
      };

      /*mac_copy: mac_copy {
          compatible = "zmk,behavior-macro";
          label = "MAC_COPY";
          #binding-cells = <0>;
          bindings = <&kp LG(C)>;
      };
      mac_paste: mac_paste {
          compatible = "zmk,behavior-macro";
          label = "MAC_PASTE";
          #binding-cells = <0>;
          bindings = <&kp LG(V)>;
      };
      mac_cut: mac_cut {
          compatible = "zmk,behavior-macro";
          label = "MAC_CUT";
          #binding-cells = <0>;
          bindings = <&kp LG(X)>;
      };
      mac_undo: mac_undo {
          compatible = "zmk,behavior-macro";
          label = "MAC_UNDO";
          #binding-cells = <0>;
          bindings = <&kp LG(Z)>;
      };*/
      mac_redo: mac_redo {
          compatible = "zmk,behavior-macro";
          label = "MAC_REDO";
          #binding-cells = <0>;
          bindings = <&kp LS(LG(Z))>;
      };
    };

  combos {
    compatible = "zmk,combos";
    combo_esc {
        timeout-ms = <50>;
        key-positions = <65 70>;
        bindings = <&kp ESC>;
    };
    combo_capsword {
        timeout-ms = <50>;
        key-positions = <29 44>;
        bindings = <&caps_word>;
    };
  };

  /* TODO: capsword*/
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";

      bindings = <
        &kp EQUAL &kp N1        &kp N2      &kp N3       &kp N4      &kp N5 &tog 1                                                                                &mo 3 &kp N6 &kp N7      &kp N8       &kp N9      &kp N0           &kp MINUS
        &kp TAB   &kp Q         &kp W       &kp E        &kp R       &kp T  &kp C_VOL_UP                                                                          &none &kp Y  &kp U       &kp I        &kp O       &kp P            &kp BSLH
        &kp ESC   &hml LSHIFT A &hml LALT S &hml LCTRL D &hml LGUI F &kp G  &kp C_VOL_DN               &kp LGUI  &kp LCTRL &kp RGUI  &kp RCTRL                    &none &kp H  &hmr RGUI J &hmr RCTRL K &hmr RALT L &hmr RSHIFT SEMI &kp SQT
        &kp LSHFT &lt 1 Z       &kp X       &kp C        &kp V       &kp B                                       &kp LALT  &kp RALT                                     &kp N  &kp M       &kp COMMA    &kp DOT     &lt 4 FSLH       &kp RSHFT
        &mo 2     &none         &none       &none        &kp GRAVE                       &qt_lt 5 BSPC &lt 2 TAB &kp ESC   &none     &lt 4 ENTER &mt LSHIFT SPACE              &kp UNDER   &none        &kp LBKT    &kp RBKT         &mo 2
      >;

    };
    keypad { /* 1 */
      display-name = "Kp";
      bindings = <
        &none &none      &none    &none     &none    &none &trans                                                  &mo 3 &none &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &none    
        &none &none      &none    &kp E     &none    &none &none                                                   &none &none &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &none   
        &none &kp LSHIFT &kp LALT &kp LCTRL &kp LGUI &none &none           &none   &none &none &none               &none &none &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &none  
        &none &trans     &none    &none     &none    &none                         &none &none                           &none &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &none    
        &none &none      &none    &none     &none              &kp BSPC &kp TAB &none &none &kp ENTER &kp KP_N0                &none      &none        &kp KP_DOT    &none           &none
      >;
    };
    fn { /* 2 */
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2     &kp F3   &kp F4    &kp F5   &kp F6 &none                                           &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &none  &none      &none    &kp E     &none    &none  &none                                           &none &none  &kp F7 &kp F8 &kp F9  &kp F12 &kp F15
        &none  &kp LSHIFT &kp LALT &kp LCTRL &kp LGUI &none  &kp C_MUTE       &none  &none &none &none       &none &none  &kp F4 &kp F5 &kp F6  &kp F11 &kp F14
        &none  &none      &none    &none     &none    &none                          &none &none                   &none  &kp F1 &kp F2 &kp F3  &kp F10 &kp F13
        &none  &none      &none    &none     &none                      &none &trans &none &none &none &none              &none  &none  &none   &none   &none
      >;
    };
    mod { /* 3 */
      display-name = "Mod";
      bindings = <
        &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                               &trans       &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &none        &none        &bootloader                                                         &bootloader  &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none             &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &macro_ver   &none                                &none &none                                              &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &none                                 &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                           &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    symbol {  /* 4 */
      display-name = "Red";    
      bindings = <
        &none &none      &none    &none    &none     &none    &none                                              &mo 3 &none     &none     &none     &none     &none     &none
        &none &kp LT     &kp LBKT &kp RBKT &kp GT    &kp HASH &none                                              &none &kp PRCNT &kp SQT   &kp EXCL  &kp QMARK &none     &none
        &none &kp CARET  &kp LPAR &kp RPAR &kp DQT   &kp DLLR &none              &none &none &none &none         &none &kp STAR  &kp EQUAL &kp PLUS  &kp MINUS &none     &none
        &none &kp BSLH   &kp LBRC &kp RBRC &kp COLON &kp AT                            &none &none                     &kp AMPS  &kp PIPE  &kp COMMA &kp DOT   &trans    &none
        &none &none      &none    &none    &kp GRAVE                  &kp BSPC &kp TAB &none &none &trans &kp SPACE              &kp UNDER &none     &none     &none     &none
      >;
    };

    button {  /* 5 */
      display-name = "Purple";    
      bindings = <
        &none &none      &none    &none     &none      &none     &none                                        &mo 3 &none    &none     &none     &none     &none &none
        &none &none      &none    &none     &none      &none     &none                                        &none &none    &none     &none     &none     &none &none
        &none &kp LSHIFT &kp LALT &kp LCTRL &kp LGUI   &kp DOT   &none        &none &none &none &none         &none &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &none &none
        &none &Mac_Undo  &Mac_Cut &Mac_Copy &Mac_Paste &mac_redo                    &none &none                     &kp HOME &kp PG_DN &kp PG_UP &kp END   &none &none
        &none &none      &none    &none     &kp SPACE                  &trans &none &none &none &none &none                  &none     &none     &none     &none &none
      >;
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
      /*bindings = <
        &none &none &none &none &none &none &none                                       &mo 3 &none &none &none &none &none &none
        &none &none &none &none &none &none &none                                       &none &none &none &none &none &none &none
        &none &none &none &none &none &none &none       &none &none &none &none         &none &none &none &none &none &none &none
        &none &none &none &none &none &none                   &none &none                     &none &none &none &none &none &none
        &none &none &none &none &none             &none &none &none &none &none &none               &none &none &none &none &none
      >;*/
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
      /*bindings = <
        &none &none &none &none &none &none &none                                       &mo 3 &none &none &none &none &none &none
        &none &none &none &none &none &none &none                                       &none &none &none &none &none &none &none
        &none &none &none &none &none &none &none       &none &none &none &none         &none &none &none &none &none &none &none
        &none &none &none &none &none &none                   &none &none                     &none &none &none &none &none &none
        &none &none &none &none &none             &none &none &none &none &none &none               &none &none &none &none &none
      >;*/
    };
  };
};
