#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/behaviors.h>

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <175>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      bspc_del: backspace_delete {
          compatible = "zmk,behavior-mod-morph";
          label = "BACKSPACE_DELETE";
          #binding-cells = <0>;
          bindings = <&kp BACKSPACE>, <&kp DELETE>;
          mods = <(MOD_LSFT|MOD_RSFT)>;
      };

      /* How to stack mod-morph and layer-tap: https://www.reddit.com/r/zmk/comments/12ujlmb/combing_modmorph_and_layer_tap/ */
      lt_bspc: layer_tap_bspc_del {
          compatible = "zmk,behavior-hold-tap";
          label = "LAYER_TAP_BACKSPACE_DELETE";
          #binding-cells = <2>;
          bindings = <&mo>, <&bspc_del>;
          tapping-term-ms = <200>;
      };

      /*mac_copy: mac_copy {
          compatible = "zmk,behavior-macro";
          label = "MAC_COPY";
          #binding-cells = <0>;
          bindings = <&kp LG(C)>;
      };
      mac_paste: mac_paste {
          compatible = "zmk,behavior-macro";
          label = "MAC_PASTE";
          #binding-cells = <0>;
          bindings = <&kp LG(V)>;
      };
      mac_cut: mac_cut {
          compatible = "zmk,behavior-macro";
          label = "MAC_CUT";
          #binding-cells = <0>;
          bindings = <&kp LG(X)>;
      };
      mac_undo: mac_undo {
          compatible = "zmk,behavior-macro";
          label = "MAC_UNDO";
          #binding-cells = <0>;
          bindings = <&kp LG(Z)>;
      };*/
      mac_redo: mac_redo {
          compatible = "zmk,behavior-macro";
          label = "MAC_REDO";
          #binding-cells = <0>;
          bindings = <&kp LS(LG(Z))>;
      };
    };

  combos {
    compatible = "zmk,combos";
    combo_esc {
        timeout-ms = <50>;
        key-positions = <65 66>;
        bindings = <&kp ESC>;
    };
    combo_capsword {
        timeout-ms = <50>;
        key-positions = <69 70>;
        bindings = <&caps_word>;
    };
  };

  /* TODO: capsword*/
  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";

      bindings = <
        &kp EQUAL &kp N1       &kp N2     &kp N3      &kp N4     &kp N5 &tog 1                                                                         &mo 3 &kp N6 &kp N7     &kp N8      &kp N9     &kp N0          &kp MINUS
        &kp TAB   &kp Q        &kp W      &kp E       &kp R      &kp T  &none                                                                          &none &kp Y  &kp U      &kp I       &kp O      &kp P           &kp BSLH
        &kp ESC   &hm LSHIFT A &hm LALT S &hm LCTRL D &hm LGUI F &kp G  &none               &kp LGUI  &kp LCTRL &kp RGUI  &kp RCTRL                    &none &kp H  &hm RGUI J &hm RCTRL K &hm RALT L &hm RSHIFT SEMI &kp SQT
        &kp LSHFT &lt 1 Z      &kp X      &kp C       &kp V      &kp B                                &kp LALT  &kp RALT                                     &kp N  &kp M      &kp COMMA   &kp DOT    &kp FSLH        &kp RSHFT
        &mo 2     &none        &none      &kp GRAVE   &kp ESC                  &lt_bspc 5 0 &lt 2 TAB &kp ESC   &none     &lt 4 ENTER &mt LSHIFT SPACE              &kp UNDER  &kp DQT     &kp LBKT   &kp RBKT        &mo 2
      >;

    };
    keypad { /* 1 */
      display-name = "Kp";
      bindings = <
        &none &none      &none    &none     &none    &none &trans                                                  &mo 3 &none &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &none    
        &none &none      &none    &kp E     &none    &none &none                                                   &none &none &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &none   
        &none &kp LSHIFT &kp LALT &kp LCTRL &kp LGUI &none &none           &none   &none &none &none               &none &none &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &none  
        &none &trans     &none    &none     &none    &none                         &none &none                           &none &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &none    
        &none &none      &none    &none     &kp ESC            &kp BSPC &kp TAB &none &none &kp ENTER &kp KP_N0                &none      &none        &none         &none           &none
      >;
    };
    fn { /* 2 */
      display-name = "Fn";
      bindings = <
        &kp F1 &kp F2     &kp F3   &kp F4    &kp F5   &kp F6 &none                                      &mo 3 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12
        &none  &none      &none    &kp E     &none    &none  &none                                      &none &none  &kp F7 &kp F8 &kp F9  &kp F12 &kp F15
        &none  &kp LSHIFT &kp LALT &kp LCTRL &kp LGUI &none  &none       &none  &none &none &none       &none &none  &kp F4 &kp F5 &kp F6  &kp F11 &kp F14
        &none  &none      &none    &none     &none    &none                     &none &none                   &none  &kp F1 &kp F2 &kp F3  &kp F10 &kp F13
        &none  &none      &none    &none     &none                 &none &trans &none &none &none &none              &none  &none  &none   &none   &none
      >;
    };
    mod { /* 3 */
      display-name = "Mod";
      bindings = <
        &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                               &trans       &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &none        &none        &bootloader                                                         &bootloader  &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none             &none &none &bt BT_CLR &none                      &stp STP_BAT &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &macro_ver   &none                                &none &none                                              &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &none                                 &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                           &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };

    symbol {  /* 4 */
      display-name = "Red";    
      bindings = <
        &none &none      &none    &none    &none     &none    &none                                              &mo 3 &none     &none     &none     &none     &none     &none
        &none &none      &kp LBKT &kp RBKT &kp HASH  &none    &none                                              &none &none     &kp EXCL  &kp CARET &kp BSLH  &none     &none
        &none &kp DOLLAR &kp LPAR &kp RPAR &kp COLON &kp STAR &none              &none &none &none &none         &none &kp ENTER &kp EQUAL &kp PLUS  &kp MINUS &kp SPACE &none
        &none &none      &kp LBRC &kp RBRC &kp AT    &none                             &none &none                     &none     &kp PIPE  &kp AMPS  &kp PRCNT &none     &none
        &none &none      &none    &none    &none                      &kp BSPC &kp TAB &none &none &trans &none                  &none     &none     &none     &none     &none
      >;
    };

    button {  /* 5 */
      display-name = "Purple";    
      bindings = <
        &none &none      &none    &none     &none      &none     &none                                        &mo 3 &none    &none     &none     &none     &none &none
        &none &none      &none    &none     &none      &none     &none                                        &none &none    &none     &none     &none     &none &none
        &none &kp LSHIFT &kp LALT &kp LCTRL &kp LGUI   &none     &none        &none &none &none &none         &none &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &none &none
        &none &Mac_Undo  &Mac_Cut &Mac_Copy &Mac_Paste &mac_redo                    &none &none                     &kp HOME &kp PG_DN &kp PG_UP &kp END   &none &none
        &none &none      &none    &none     &none                      &trans &none &none &none &none &none                  &none     &none     &none     &none &none
      >;
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
      /*bindings = <
        &none &none &none &none &none &none &none                                       &mo 3 &none &none &none &none &none &none
        &none &none &none &none &none &none &none                                       &none &none &none &none &none &none &none
        &none &none &none &none &none &none &none       &none &none &none &none         &none &none &none &none &none &none &none
        &none &none &none &none &none &none                   &none &none                     &none &none &none &none &none &none
        &none &none &none &none &none             &none &none &none &none &none &none               &none &none &none &none &none
      >;*/
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
      /*bindings = <
        &none &none &none &none &none &none &none                                       &mo 3 &none &none &none &none &none &none
        &none &none &none &none &none &none &none                                       &none &none &none &none &none &none &none
        &none &none &none &none &none &none &none       &none &none &none &none         &none &none &none &none &none &none &none
        &none &none &none &none &none &none                   &none &none                     &none &none &none &none &none &none
        &none &none &none &none &none             &none &none &none &none &none &none               &none &none &none &none &none
      >;*/
    };
  };
};
